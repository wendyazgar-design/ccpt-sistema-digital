import express from 'express';
import fs from 'fs';
import path from 'path';
import multer from 'multer';
import { fileURLToPath } from 'url';
import { pool } from '../db.js';
import { authMiddleware } from '../middleware/auth.js';

const router = express.Router();
const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const uploadRoot = path.join(__dirname, '..', 'uploads');

if (!fs.existsSync(uploadRoot)) {
  fs.mkdirSync(uploadRoot, { recursive: true });
}

const storage = multer.diskStorage({
  destination: (_req, _file, cb) => cb(null, uploadRoot),
  filename: (_req, file, cb) => {
    const safeName = `${Date.now()}-${file.originalname.replace(/\s+/g, '-')}`;
    cb(null, safeName);
  },
});

const upload = multer({ storage });

router.post('/upload/:expedienteId', authMiddleware, upload.single('file'), async (req, res) => {
  const { expedienteId } = req.params;

  if (!req.file) {
    return res.status(400).json({ message: 'No se recibió ningún archivo' });
  }

  try {
    const expedienteResult = await pool.query('SELECT * FROM expedientes WHERE id = $1', [expedienteId]);
    const expediente = expedienteResult.rows[0];

    if (!expediente) {
      return res.status(404).json({ message: 'Expediente no encontrado' });
    }

    if (req.user.role === 'socio' && expediente.user_id !== req.user.id) {
      return res.status(403).json({ message: 'No puedes subir documentos a este expediente' });
    }

    const relativePath = path.relative(path.join(__dirname, '..'), req.file.path).replace(/\\/g, '/');

    const result = await pool.query(
      `INSERT INTO documents (expediente_id, file_name, storage_path, mime_type, uploaded_by)
       VALUES ($1, $2, $3, $4, $5) RETURNING *`,
      [expedienteId, req.file.originalname, relativePath, req.file.mimetype, req.user.id]
    );

    res.status(201).json(result.rows[0]);
  } catch (error) {
    res.status(500).json({ message: 'Error al subir documento', details: error.message });
  }
});

router.get('/:expedienteId', authMiddleware, async (req, res) => {
  try {
    const expedienteResult = await pool.query('SELECT user_id FROM expedientes WHERE id = $1', [req.params.expedienteId]);
    const expediente = expedienteResult.rows[0];

    if (!expediente) {
      return res.status(404).json({ message: 'Expediente no encontrado' });
    }

    if (req.user.role === 'socio' && expediente.user_id !== req.user.id) {
      return res.status(403).json({ message: 'No puedes consultar los documentos de este expediente' });
    }

    const result = await pool.query(
      'SELECT * FROM documents WHERE expediente_id = $1 ORDER BY created_at DESC',
      [req.params.expedienteId]
    );
    res.json(result.rows);
  } catch (error) {
    res.status(500).json({ message: 'Error al listar documentos', details: error.message });
  }
});

export default router;
